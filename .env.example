# =====================================================
# My Balanced Family Finances — Environment Variables
# =====================================================
# Copy this file to .env.local and fill in values
# Never commit .env.local to version control
# =====================================================

# -----------------------------------------------------
# Supabase (Required)
# Get from: Supabase Dashboard → Settings → API
# -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=                    # Project URL (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_ANON_KEY=               # anon/public key (safe for browser)

# -----------------------------------------------------
# App Configuration
# -----------------------------------------------------
NEXT_PUBLIC_APP_URL=                          # App URL (use http://localhost:3000 for dev, or your Vercel URL for production e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_NAME="My Balanced Family Finances"

# -----------------------------------------------------
# Feature Flags (Optional)
# Set to "true" to enable
# -----------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=false           # Enable PostHog analytics (v1.1)
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=false      # Enable Sentry error tracking (v1.1)
NEXT_PUBLIC_ENABLE_REALTIME=true             # Enable Supabase realtime subscriptions

# -----------------------------------------------------
# Development Only (Optional)
# -----------------------------------------------------
NEXT_PUBLIC_DEBUG_SYNC=false                 # Log sync operations to console
NEXT_PUBLIC_MOCK_OFFLINE=false               # Simulate offline mode for testing
